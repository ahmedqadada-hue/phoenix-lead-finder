# ---- Phoenix Lead Finder configuration ----
# Copy this file to ".env" and fill the values. Never commit ".env".

# PostgreSQL connection. With docker-compose keep the host "db".
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=phoenix
DATABASE_URL=postgresql://phoenix:change-me-strong-password@db:5432/phoenix

# 64 hex characters. Encrypts API keys stored in the database.
# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=

# Public address of the app (used for secure cookies). Example: https://leads.example.com
APP_URL=http://localhost:3000

# Domain for automatic HTTPS (Caddy). Example: leads.example.com
DOMAIN=localhost

# Contact shown to websites and OpenStreetMap in the crawler User-Agent (recommended).
CRAWLER_CONTACT=
